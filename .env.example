# Environment Variables Configuration
# Copy this file to .env and fill in your values

# Port for backend Express server
PORT=3000
NODE_ENV=development

# Translation Provider selector: 'google' | 'libretranslate' | 'microsoft' | 'gemini' | 'mock'
# Defaults to 'google' (Google Cloud Translation API v2)
TRANSLATION_PROVIDER="google"

# Google Cloud Translation API (v2)
# Get your API key from Google Cloud Console > APIs & Services > Credentials
GOOGLE_TRANSLATE_API_KEY="your_google_cloud_api_key_here"

# LibreTranslate Configuration (Optional - if using LibreTranslate provider)
LIBRETRANSLATE_URL="https://libretranslate.com"
LIBRETRANSLATE_API_KEY=""

# Microsoft Translator Configuration (Optional - if using Microsoft provider)
AZURE_TRANSLATOR_KEY=""
AZURE_TRANSLATOR_REGION="global"

# Gemini API Key (Alternative translation & detection engine)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Frontend Origin for CORS security whitelist (comma-separated if multiple)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
