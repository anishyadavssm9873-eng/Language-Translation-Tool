# Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Active Provider: 'google' | 'libretranslate' | 'microsoft'
TRANSLATION_PROVIDER=google

# Google Cloud Translation API v2 Key
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key_here

# LibreTranslate (if using libretranslate provider)
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# Microsoft Azure Translator (if using microsoft provider)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global

# Allowed Frontend Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
